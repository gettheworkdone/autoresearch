# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. The bot ignores everyone else.
TELEGRAM_ALLOWED_USER_ID=

# Optional global credentials passed into Codex.
# Modern Kaggle auth: use the API token.
# Create/rotate the token in Kaggle Account -> API, then paste the full KGAT_... value here.
KAGGLE_API_TOKEN=

# Which global .env variables may be passed into Codex.
PASSTHROUGH_ENV_NAMES=KAGGLE_API_TOKEN

# Where all autoresearch task folders are stored.
DATA_ROOT=/var/lib/autoresearch

# Codex CLI binary and isolated execution user.
CODEX_BIN=/usr/bin/codex
CODEX_USER=codexrun
CODEX_HOME=/home/codexrun/.codex

# Default Codex model and the model buttons shown in Telegram.
DEFAULT_MODEL=gpt-5.5
AVAILABLE_MODELS=gpt-5.5,gpt-5.4,gpt-5.3-codex

# Default thinking/reasoning level shown in Telegram.
# Values: light, standard, heavy, extra
DEFAULT_REASONING_EFFORT=standard

# Max Telegram result messages before automatic pause.
DEFAULT_MAX_RESULT_MESSAGES=50

# Latest Telegram messages inserted into model context by default.
# You can change per task with /contextmessages or /contextmessages N.
DEFAULT_CONTEXT_MESSAGE_LIMIT=30

# How to send context snapshots.
# Values: file, summary, off
SEND_CONTEXT_MODE=file

# Codex execution settings.
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=never
CODEX_ENABLE_LIVE_SEARCH=true
CODEX_ENABLE_NETWORK=true

# If false, each run rebuilds context from task files instead of relying on Codex session memory.
RESUME_CODEX_SESSION=false

# Maximum single uploaded file size in MB.
MAX_UPLOAD_MB=200

# ZIP extraction safety limits.
MAX_ZIP_TOTAL_MB=1000
MAX_ZIP_FILES=5000

# Delay between autonomous cycles in seconds.
LOOP_DELAY_SECONDS=2

# If true, a normal text message in a draft task starts the loop.
# Files and captions are stored as supplementary material and do not start iterations.
AUTO_START_DRAFT_ON_MESSAGE=true

# Timeout for one Codex cycle, in seconds.
CODEX_TIMEOUT_SECONDS=7200
